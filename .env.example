NEXT_PUBLIC_SUPABASE_URL=https://yyeidanzflitrstvooxw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key
# Legacy fallback during migration only:
SUPABASE_SERVICE_ROLE_KEY=
# Optional explicit provider override. Leave empty to use the DB-managed plan/quality routes.
# When OPENROUTER_API_KEY is present, OpenRouter is automatically used for test image generation.
SOLAMENTIS_ACTIVE_PROVIDER=
OPENROUTER_API_KEY=replace-with-openrouter-api-key
# Optional model overrides. Leave empty for automatic capability-based test model selection.
OPENROUTER_IMAGE_MODEL=
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_VIDEO_MODEL=
OPENROUTER_VIDEO_HIGH_MODEL=
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_HTTP_REFERER=https://solamentis.app
OPENROUTER_APP_NAME=Solamentis
HF_TOKEN=optional-server-provider-token
GOOGLE_AI_API_KEY=optional-server-provider-key
CRON_SECRET=replace-with-random-worker-secret
# Required for paid-plan tamper-evident image provenance. Generate a long random secret and keep it server-side.
SOLAMENTIS_PROVENANCE_SECRET=replace-with-long-random-server-only-secret
