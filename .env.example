# ============================================================
# Solamentis local development environment
# Copy this file to .env.local and replace placeholders.
# Never commit .env.local or real API keys.
# ============================================================

# ------------------------- Supabase --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://yyeidanzflitrstvooxw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key
SUPABASE_SECRET_KEY=replace-with-supabase-server-secret-key
# Legacy migration fallback only. Prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------- Public application ------------------
NEXT_PUBLIC_APP_URL=https://solamentis.app

# ---------------------- Provider routing ---------------------
# Leave blank to use Supabase-configured provider/model routes.
SOLAMENTIS_ACTIVE_PROVIDER=
SOLAMENTIS_IMAGE_PROVIDER=
SOLAMENTIS_VIDEO_PROVIDER=

# -------------------- Enabled image providers ---------------
GOOGLE_AI_API_KEY=replace-with-google-ai-api-key
FAL_KEY=replace-with-fal-api-key
IDEOGRAM_API_KEY=replace-with-ideogram-api-key

# --------------------- Image analysis/video -----------------
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_IMAGE_MODEL=
OPENROUTER_ANALYSIS_MODEL=
OPENROUTER_VIDEO_MODEL=
OPENROUTER_VIDEO_HIGH_MODEL=
OPENROUTER_TIMEOUT_MS=180000
OPENROUTER_HTTP_REFERER=https://solamentis.app
OPENROUTER_APP_NAME=Solamentis

# ----------------- Hugging Face / safety ---------------------
HF_TOKEN=replace-with-huggingface-token

# ------------------- Optional test provider ------------------
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_VIDEO_MODEL=minimax-h3
POLLINATIONS_VIDEO_HIGH_MODEL=minimax-h3
POLLINATIONS_TIMEOUT_MS=180000

# ---------------------- Worker/security ----------------------
CRON_SECRET=replace-with-long-random-cron-secret
SOLAMENTIS_PROVENANCE_SECRET=replace-with-long-random-provenance-secret

# ------------------------- Stripe -----------------------------
# Required for subscription and $5 credit top-up checkout.
STRIPE_SECRET_KEY=replace-with-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-signing-secret
