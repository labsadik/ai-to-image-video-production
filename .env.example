# ============================================================
# Solamentis application environment template
# Copy this file to .env.local for local development.
# Replace every placeholder with a real value.
# NEVER commit .env.local or real secrets.
# ============================================================

# ------------------------- Supabase --------------------------
NEXT_PUBLIC_SUPABASE_URL=https://id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
# Server-only key. Never expose to the browser.
SUPABASE_SECRET_KEY=<supabase-server-secret-key>

# ---------------------- Public application ------------------
# Use the exact deployed Next.js application origin in production.
NEXT_PUBLIC_APP_URL=https://<your-real-production-domain>

# ---------------------- AI providers -------------------------
# Free test image generation: Pixazo Flux Schnell
PIXAZO_API_KEY=<pixazo-api-key>

# Free test image analysis: Groq Qwen 3.6 27B Vision
GROQ_API_KEY=<groq-api-key>

# Existing paid/alternate providers retained for production migration paths.
GOOGLE_AI_API_KEY=<google-ai-api-key>
FAL_KEY=<fal-api-key>

# ---------------------- Worker/security ----------------------
CRON_SECRET=<long-random-internal-secret>
SOLAMENTIS_PROVENANCE_SECRET=<long-random-provenance-secret>

# ------------------------- Stripe ----------------------------
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-signing-secret>

# -------------------------------------------------------------
# Supabase Edge Function note
# -------------------------------------------------------------
# The generation-worker Edge Function also requires the server-side
# secret SOLAMENTIS_APP_URL, pointing to the deployed Next.js origin.
# Supabase provides SUPABASE_URL to Edge Functions automatically.
# Configure Edge Function secrets in Supabase, not in browser code.
